meta {
  name: CREATE
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/bff/nodes
  body: json
  auth: inherit
}

body:json {
  {"workflow_id": "{{WORKFLOW_ID}}",
    "name": "Email Parser Node",
    "description": "Parse incoming email data",
    "script_id": "{{SCRIPT_ID}}",
    "params": {
      "input_format": "json",
      "batch_size": 100,
      "timeout_per_item": 30
    },
    "max_retries": 5,
    "timeout_seconds": 600
  }
}

settings {
  encodeUrl: true
}
