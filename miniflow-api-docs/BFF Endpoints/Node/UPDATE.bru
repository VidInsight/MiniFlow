meta {
  name: UPDATE
  type: http
  seq: 3
}

put {
  url: {{BASE_URL}}/api/bff/nodes/{{NODE_ID}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Updated Node Name",      // Optional
    "description": "Updated desc",    // Optional
    "script_id": "new_script_id",    // Optional
    "meta_data": {                   // Optional - Will replace existing
      "updated_key": "updated_value"
    },
    "params": {                      // Optional - Will replace existing
      "new_param": "new_value"
    },
    "max_retries": 5,                // Optional
    "timeout_seconds": 600           // Optional
  }
}

settings {
  encodeUrl: true
}
