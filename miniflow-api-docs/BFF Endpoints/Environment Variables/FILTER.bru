meta {
  name: FILTER
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/bff/envar/filter
  body: json
  auth: inherit
}

body:json {
  {
    "filters": {
      "scope": "GLOBAL"
    },
    "skip": 0,
    "limit": 100,
    "order_by_field": "key",
    "include_relationships": false,
    "exclude_fields": ["value"]
  }
}

settings {
  encodeUrl: true
}
