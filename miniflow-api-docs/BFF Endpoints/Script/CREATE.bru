meta {
  name: CREATE
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/bff/scripts/
  body: json
  auth: inherit
}

body:json {
  {
    "name": "test_script",
    "description": "Test script for Bruno",
    "category": "TEST",
    "content": "print('Hello from Bruno test!')",
    "file_extension": ".py",
    "version": "1.0.0",
    "author": "Bruno Test",
    "subcategory": "API_TEST",
    "input_schema": {
      "type": "object",
      "properties": {
        "input_param": {"type": "string"}
      }
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": {"type": "string"}
      }
    },
    "test_input_params": {
      "input_param": "test_value"
    },
    "test_output_params": {
      "result": "success"
    }
  }
}

settings {
  encodeUrl: true
}
