meta {
  name: FILTER
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/bff/scripts/filter
  body: json
  auth: inherit
}

body:json {
  {
    "filters": {
      "file_extension": ".py"
    },
    "skip": 0,
    "limit": 100,
    "order_by_field": "name",
    "include_relationships": false,
    "exclude_fields": []
  }
}

settings {
  encodeUrl: true
}
