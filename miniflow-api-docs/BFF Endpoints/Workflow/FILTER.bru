meta {
  name: FILTER
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/bff/workflows/filter
  body: json
  auth: inherit
}

body:json {
  {
    "filters": {
      "status": "DRAFT"
    },
    "skip": 0,
    "limit": 100,
    "order_by_field": "created_at",
    "include_relationships": false,
    "exclude_fields": ["status_message"]
  }
}

settings {
  encodeUrl: true
}
