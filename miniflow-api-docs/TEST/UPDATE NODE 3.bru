meta {
  name: UPDATE NODE 3
  type: http
  seq: 10
}

put {
  url: {{BASE_URL}}/api/bff/nodes/{{NODE_3_ID}}
  body: json
  auth: inherit
}

body:json {
  {
    "input_params": {
      "num1": {
        "value": "{n{ND-483F82F31DED4A059.sum}}",
        "type": "number",
        "format": "integer",
        "description": "Result from previous node (15+3=18)",
        "required": true
      },
      "num2": {
        "value": 7,
        "type": "number",
        "format": "integer",
        "description": "Second number to add",
        "required": true
      }
    }
  }
}

settings {
  encodeUrl: true
}
